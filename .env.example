# Пример конфигурации (реальный файл — только на сервере: `sudo bash scripts/install_docker.sh` создаёт `.env`)

SECRET_KEY='change-me'
DEBUG=0
FORCE_HTTPS=0
USE_X_ACCEL=1
ALLOWED_HOSTS='localhost,127.0.0.1'
DB_NAME='keepix_db'
DB_USER='keepix_user'
DB_PASSWORD='change-me'
DB_HOST=db
DB_PORT=5432
APP_PORT=80

# Опционально
# MAX_LOGIN_ATTEMPTS=8 # максимальное количество попыток входа в систему
# LOGIN_LOCK_MINUTES=30 # время блокировки после максимального количества попыток входа в систему
# BACKUP_DB_KEEP_LAST=3 # количество последних бекапов базы данных для хранения
# BACKUP_FULL_ROOT=/app/backups/full # каталог для backup_full (.tar.gz)
# INTERNAL_MEDIA_LOCATION=/internal-media/ # путь к внутренним медиа-файлам
